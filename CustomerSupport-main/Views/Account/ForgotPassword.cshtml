@model CustomerSupportAI.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    var available = ViewData["EmailAvailable"] as bool? == true;
}

<section class="auth-shell">
    <div class="auth-aside">
        <span class="eyebrow">Khôi phục tài khoản</span>
        <h1>Lấy lại quyền truy cập.</h1>
        <p>Nhập email hoặc số điện thoại đã đăng ký. Chúng tôi sẽ gửi liên kết đặt lại mật khẩu tới email của tài khoản.</p>
        <div class="auth-roles">
            <div class="auth-role">
                <icon name="clock" />
                <div><strong>Hiệu lực 30 phút</strong><span>Liên kết chỉ dùng được một lần và hết hạn sau 30 phút.</span></div>
            </div>
            <div class="auth-role">
                <icon name="shield-check" />
                <div><strong>Bảo vệ tài khoản</strong><span>Sau khi đặt lại, mọi phiên đăng nhập cũ đều bị đăng xuất.</span></div>
            </div>
        </div>
        <p class="auth-note"><icon name="lock" class="icon-sm" />Nhân viên hỗ trợ không bao giờ hỏi mật khẩu hay liên kết đặt lại của bạn.</p>
    </div>
    <div class="auth-panel">
        <span class="eyebrow">Quên mật khẩu</span>
        <h2>Đặt lại mật khẩu</h2>
        <p>Nhập thông tin bạn dùng để đăng nhập.</p>
        <form asp-action="ForgotPassword" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            @if (ViewData["UsesOutbox"] as bool? == true)
            {
                <div class="alert alert-info"><icon name="info" /><p>Chế độ phát triển: chưa cấu hình SMTP nên email được lưu vào thư mục <code>App_Data/mail-outbox</code> trên máy chủ thay vì gửi đi.</p></div>
            }
            <div class="field">
                <label class="field-label is-required" asp-for="Email">Email / Số điện thoại</label>
                <span class="input-group">
                    <icon name="mail" />
                    <input asp-for="Email" autocomplete="username" placeholder="ban@congty.vn hoặc 0912345678" disabled="@(available ? null : "disabled")" />
                </span>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <button class="btn btn-primary btn-lg btn-block" type="submit" disabled="@(available ? null : "disabled")"><icon name="send" />Gửi liên kết đặt lại</button>
        </form>
        <p class="auth-switch">Đã nhớ mật khẩu? <a asp-action="Login">Quay lại đăng nhập</a></p>
    </div>
</section>
