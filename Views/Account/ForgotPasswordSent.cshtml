@{
    ViewData["Title"] = "Kiểm tra email";
}

<section class="auth-single card">
    <span class="auth-single-icon"><icon name="mail" /></span>
    <h1>Kiểm tra hộp thư của bạn</h1>
    <p>Nếu thông tin vừa nhập khớp với một tài khoản đang hoạt động, chúng tôi đã gửi liên kết đặt lại mật khẩu tới email của tài khoản đó. Liên kết có hiệu lực trong 30 phút.</p>
    <p class="cell-sub">Không thấy email? Kiểm tra thư mục Spam, hoặc gửi lại yêu cầu sau vài phút.</p>
    @if (ViewData["UsesOutbox"] as bool? == true)
    {
        <div class="alert alert-info"><icon name="info" /><p>Chế độ phát triển: mở tệp mới nhất trong <code>App_Data/mail-outbox</code> để lấy liên kết.</p></div>
    }
    <div class="auth-single-actions">
        <a class="btn btn-secondary" asp-action="ForgotPassword"><icon name="refresh-cw" />Gửi lại</a>
        <a class="btn btn-primary" asp-action="Login"><icon name="log-in" />Quay lại đăng nhập</a>
    </div>
</section>
