@model List<TicketMessage>
<div class="dropdown-header">
    <strong>Hoạt động mới nhất</strong>
    <span class="cell-sub">Trong yêu cầu bạn được xem</span>
</div>
@if (Model.Count == 0)
{
    <p class="notif-empty">Chưa có phản hồi mới từ người khác.</p>
}
else
{
    foreach (var m in Model)
    {
        var team = m.Author.Role != UserRoles.Customer;
        <a class="notif-item" asp-controller="Tickets" asp-action="Details" asp-route-id="@m.TicketId">
            <span class="avatar avatar-sm @(team ? "avatar-team" : "")">@m.Author.DisplayName[..1]</span>
            <span>
                <strong class="notif-title">@m.Author.DisplayName · @m.Ticket.TicketNumber</strong>
                <p>@m.Body</p>
                <small>@m.CreatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</small>
            </span>
        </a>
    }
}
<a class="dropdown-footer" asp-controller="Dashboard" asp-action="Activity">Xem toàn bộ hoạt động</a>
