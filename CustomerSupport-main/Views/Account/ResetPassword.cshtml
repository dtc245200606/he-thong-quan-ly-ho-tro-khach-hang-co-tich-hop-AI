@model CustomerSupportAI.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt mật khẩu mới";
    var valid = ViewData["TokenValid"] as bool? == true;
}

@if (!valid)
{
    <section class="auth-single card">
        <span class="auth-single-icon tone-danger"><icon name="circle-alert" /></span>
        <h1>Liên kết không còn hiệu lực</h1>
        <p>Liên kết đặt lại mật khẩu đã hết hạn sau 30 phút, đã được sử dụng, hoặc không đúng. Hãy gửi yêu cầu mới.</p>
        <div class="auth-single-actions">
            <a class="btn btn-secondary" asp-action="Login">Đăng nhập</a>
            <a class="btn btn-primary" asp-action="ForgotPassword"><icon name="send" />Gửi liên kết mới</a>
        </div>
    </section>
}
else
{
    <section class="auth-single card">
        <span class="auth-single-icon"><icon name="key-round" /></span>
        <h1>Đặt mật khẩu mới</h1>
        <p>Mật khẩu mới cần có ít nhất 10 ký tự. Sau khi lưu, mọi phiên đăng nhập cũ của tài khoản sẽ bị đăng xuất.</p>
        <form asp-action="ResetPassword" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="Token" type="hidden" />
            <div class="field">
                <label class="field-label is-required" asp-for="NewPassword">Mật khẩu mới</label>
                <input asp-for="NewPassword" autocomplete="new-password" placeholder="Ít nhất 10 ký tự" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label class="field-label is-required" asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button class="btn btn-primary btn-lg btn-block" type="submit"><icon name="check" />Lưu mật khẩu mới</button>
        </form>
    </section>
}
