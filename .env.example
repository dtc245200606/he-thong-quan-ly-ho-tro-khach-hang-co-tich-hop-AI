# Reference only: ASP.NET Core does NOT load .env files automatically.
# Set process environment variables in PowerShell or your hosting platform.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5180
ConnectionStrings__DefaultConnection=Data Source=customer-support.db
BootstrapAdmin__LocalSetup=false
BootstrapAdmin__Email=
BootstrapAdmin__Password=
BootstrapAdmin__Name=CustomerSupport Administrator
Gemini__Model=gemini-3.8-flash
Gemini__ApiKey=
# Alternative key names: GEMINI_API_KEY or GOOGLE_API_KEY (set only one).
# Website chatbot: auto | groq | gemini | mock (auto = Groq if a key exists, then Gemini, then mock).
Chatbot__Provider=auto
Chatbot__FallbackToMock=true
# Groq API key for the chatbot (console.groq.com/keys); GROQ_API_KEY also works. Can be entered at /Settings instead.
Groq__ApiKey=
Groq__Model=openai/gpt-oss-120b
# Optional limits (defaults shown): Chatbot__MessagesPerMinutePerSession=10, Chatbot__SessionsPerMinutePerIp=20,
# Chatbot__MaxMessageLength=1000, Chatbot__MaxToolRounds=4
# Persistent Data Protection key ring (servers/containers). Without it saved API keys break after a restart.
# DataProtection__KeysDirectory=C:\CustomerSupportData\keys
# First-response SLA hours per priority are in appsettings.json (Sla:FirstResponseHours).
# Optional: absolute writable path outside wwwroot for protected settings.
# AiSettings__StorageDirectory=C:\CustomerSupportData\settings
# Password-reset email (SMTP). Without Smtp__Host, Development writes mails to App_Data/mail-outbox.
App__BaseUrl=
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=
Smtp__EnableSsl=true
# Mail__OutboxDirectory=C:\CustomerSupportData\mail-outbox
