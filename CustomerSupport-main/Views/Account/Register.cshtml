@model CustomerSupportAI.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<section class="auth-shell">
    <div class="auth-aside">
        <span class="eyebrow">Hỗ trợ nhanh chóng và thuận tiện</span>
        <h1>Luôn đồng hành cùng bạn.</h1>
        <p>Tạo tài khoản để gửi yêu cầu, theo dõi phản hồi và lưu lại lịch sử hỗ trợ.</p>
        <div class="auth-roles">
            <div class="auth-role"><icon name="ticket" /><div><strong>Theo dõi yêu cầu</strong><span>Mọi trao đổi với đội ngũ hỗ trợ ở cùng một nơi.</span></div></div>
            <div class="auth-role"><icon name="sparkles" /><div><strong>Trợ lý thông minh</strong><span>Giải đáp nhanh dựa trên kho hướng dẫn.</span></div></div>
        </div>
        <p class="auth-note"><icon name="shield-check" class="icon-sm" />Tài khoản đăng ký mới có quyền Khách hàng.</p>
    </div>
    <div class="auth-panel">
        <span class="eyebrow">Bắt đầu</span>
        <h2>Tạo tài khoản khách hàng</h2>
        <p>Thông tin của bạn chỉ được dùng để quản lý các yêu cầu hỗ trợ.</p>
        <form asp-action="Register" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="field">
                <label class="field-label is-required" asp-for="DisplayName">Họ và tên</label>
                <input asp-for="DisplayName" autocomplete="name" placeholder="Nguyễn Minh Anh" />
                <span asp-validation-for="DisplayName" class="field-error"></span>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label class="field-label is-required" asp-for="Email">Địa chỉ email</label>
                    <input asp-for="Email" autocomplete="email" placeholder="ban@congty.vn" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="field">
                    <label class="field-label" asp-for="PhoneNumber">Số điện thoại</label>
                    <input asp-for="PhoneNumber" autocomplete="tel" placeholder="0912345678" />
                    <span class="field-hint">Không bắt buộc, dùng để đăng nhập.</span>
                    <span asp-validation-for="PhoneNumber" class="field-error"></span>
                </div>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label class="field-label is-required" asp-for="Password">Mật khẩu</label>
                    <input asp-for="Password" autocomplete="new-password" placeholder="Ít nhất 10 ký tự" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <div class="field">
                    <label class="field-label is-required" asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            </div>
            <button class="btn btn-primary btn-lg btn-block" type="submit"><icon name="user-plus" />Tạo tài khoản</button>
        </form>
        <p class="auth-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
    </div>
</section>
