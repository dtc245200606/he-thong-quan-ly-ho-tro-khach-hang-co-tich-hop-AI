@model CustomerSupportAI.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<a class="back-link" asp-action="Profile"><icon name="arrow-left" class="icon-sm" />Tài khoản của bạn</a>
<div class="form-page">
    <header class="page-header">
        <div>
            <span class="eyebrow">Bảo mật tài khoản</span>
            <h1>Đổi mật khẩu</h1>
            <p class="page-subtitle">Mật khẩu mới cần có ít nhất 10 ký tự.</p>
        </div>
    </header>
    <form asp-action="ChangePassword" method="post" class="card card-body form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="field">
            <label class="field-label is-required" asp-for="CurrentPassword">Mật khẩu hiện tại</label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>
        <div class="form-grid">
            <div class="field">
                <label class="field-label is-required" asp-for="NewPassword">Mật khẩu mới</label>
                <input asp-for="NewPassword" autocomplete="new-password" placeholder="Ít nhất 10 ký tự" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label class="field-label is-required" asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>
        <div class="form-actions">
            <span>Phiên đăng nhập hiện tại vẫn được duy trì.</span>
            <div>
                <a class="btn btn-secondary" asp-action="Profile">Hủy</a>
                <button class="btn btn-primary" type="submit"><icon name="check" />Cập nhật mật khẩu</button>
            </div>
        </div>
    </form>
</div>
